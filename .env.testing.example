APP_NAME="PRIME Google"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://prime-google.test

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_preventive_maintenance_ai_test
DB_USERNAME=your_local_mysql_username
DB_PASSWORD=your_local_mysql_password
# Must stay empty: a non-empty URL overrides DB_DATABASE.
DB_URL=

CACHE_STORE=array
CACHE_PREFIX=prime_google_test_cache_
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_COOKIE=prime_google_test_session
SESSION_SECURE_COOKIE=null
SESSION_CONNECTION=
SESSION_STORE=

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=prime_google_qa_knowledge

GEMINI_API_KEY=
